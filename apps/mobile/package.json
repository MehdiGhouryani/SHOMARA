{
  "name": "@math/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "cd ../.. && npm run build:packages",
    "verify:release": "cd ../.. && npm run verify:mobile-release",
    "build:apk": "eas build --platform android --profile preview",
    "build:store": "eas build --platform android --profile production",
    "deps:check": "expo install --check"
  },
  "dependencies": {
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@math/content-delivery": "*",
    "@math/contracts": "*",
    "@math/design-system": "*",
    "@math/learning-runtime": "*",
    "@math/offline-sync": "*",
    "@rive-app/react-native": "0.4.20",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "typescript": "^5.9.2"
  }
}

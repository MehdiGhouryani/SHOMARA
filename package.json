{
  "name": "math-learning-product",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:packages": "npm --workspace @math/learning-runtime run build && npm --workspace @math/assignment-runtime run build && npm --workspace @math/adult-projections run build && npm --workspace @math/offline-sync run build && npm --workspace @math/challenge-runtime run typecheck",
    "build": "npm run build:packages && npm --workspace @math/web run build",
    "start": "npm --workspace @math/web run start",
    "dev:web": "node scripts/dev.mjs",
    "dev:mobile": "npm --workspace @math/mobile run start",
    "build:web": "npm --workspace @math/web run build",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:web",
    "typecheck:contracts": "npm --workspace @math/contracts run typecheck",
    "typecheck:design-system": "npm --workspace @math/design-system run typecheck",
    "test:unit": "vitest run",
    "verify:p01": "node scripts/verify-phase1-product-lock.mjs",
    "verify:p02": "node scripts/verify-phase2-foundation.mjs",
    "verify:p02:full": "node scripts/run-p02-gates.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "typecheck:web": "npm --workspace @math/web run typecheck",
    "lint": "tsc --project apps/web/tsconfig.json --noEmit",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:p06": "node scripts/verify-p06-mission-engine.mjs",
    "verify:p07": "node scripts/verify-p07-collection.mjs",
    "verify:p08": "node scripts/verify-p08-avatar.mjs",
    "verify:p09": "node scripts/verify-p09-worlds.mjs",
    "verify:p10-batch-a": "node scripts/verify-p10-batch-a.mjs",
    "verify:p10-batch-a-depth": "node scripts/verify-p10-batch-a-depth.mjs",
    "verify:p10-batch-b-depth": "node scripts/verify-p10-batch-b-depth.mjs",
    "verify:p10-batch-c-depth": "node scripts/verify-p10-batch-c-depth.mjs",
    "verify:p10-batch-d-depth": "node scripts/verify-p10-batch-d-depth.mjs",
    "verify:p10-batch-e-depth": "node scripts/verify-p10-batch-e-depth.mjs",
    "verify:p10-batch-b": "node scripts/verify-p10-batch-b.mjs",
    "verify:p10-batch-c": "node scripts/verify-p10-batch-c.mjs",
    "verify:p10-batch-d": "node scripts/verify-p10-batch-d.mjs",
    "verify:p10-batch-e": "node scripts/verify-p10-batch-e.mjs",
    "verify:p11": "node scripts/verify-p11-rhythm.mjs",
    "build:runtime": "npm --workspace @math/learning-runtime run build",
    "build:assignment-runtime": "npm --workspace @math/assignment-runtime run build",
    "typecheck:assignment": "npm --workspace @math/assignment-runtime run typecheck",
    "verify:phase7": "node scripts/verify-phase7.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs",
    "build:offline-sync": "npm --workspace @math/offline-sync run build",
    "typecheck:offline-sync": "npm --workspace @math/offline-sync run typecheck",
    "typecheck:challenge-runtime": "npm --workspace @math/challenge-runtime run typecheck",
    "verify:phase9": "node scripts/verify-phase9.mjs",
    "verify:phase10": "node scripts/verify-phase10.mjs",
    "performance:phase10": "node scripts/performance/phase10-performance.mjs",
    "e2e:web": "playwright test",
    "verify:migrations": "node scripts/verify-migrations-static.mjs",
    "verify:phase16": "node scripts/verify-phase16-deep-audit.mjs",
    "design-system:generate": "node scripts/generate-design-system-css.mjs",
    "verify:uiux:p3": "node scripts/verify-uiux-phase3.mjs",
    "verify:uiux:p4": "node scripts/verify-uiux-phase4.mjs",
    "verify:uiux:p5": "node scripts/verify-uiux-phase5.mjs",
    "verify:uiux:p6": "node scripts/verify-uiux-phase6.mjs",
    "verify:uiux:p7": "node scripts/verify-uiux-phase7.mjs",
    "verify:uiux:p7.5": "node scripts/verify-uiux-phase7-5.mjs",
    "verify:uiux:p8": "node scripts/verify-uiux-phase8.mjs",
    "verify:uiux:path2": "node scripts/verify-uiux-path2.mjs",
    "verify:uiux:p9": "node scripts/verify-uiux-phase9.mjs",
    "verify:mobile-release": "node scripts/verify-mobile-release.mjs",
    "mobile:apk": "npm --workspace @math/mobile run build:apk",
    "mobile:store": "npm --workspace @math/mobile run build:store",
    "verify:ux:p10": "node scripts/verify-ux-p10-final.mjs",
    "verify:p03": "node scripts/verify-phase3-game-feel.mjs",
    "typecheck:all": "npm --workspace @math/contracts run typecheck && npm --workspace @math/design-system run typecheck && npm --workspace @math/learning-runtime run typecheck && npm --workspace @math/challenge-runtime run typecheck && npm --workspace @math/assignment-runtime run typecheck && npm --workspace @math/adult-projections run typecheck && npm --workspace @math/offline-sync run typecheck && npm --workspace @math/web run typecheck && npm --workspace @math/mobile run typecheck",
    "verify:static:all": "node scripts/verify-static-all.mjs",
    "mobile:deps:check": "npm --workspace @math/mobile run deps:check",
    "test:challenge-runtime": "node scripts/test-challenge-runtime.mjs",
    "verify:phase4:runtime": "npm run test:challenge-runtime && node scripts/verify-phase4-challenge-foundation.mjs",
    "parity": "node scripts/parity-run.mjs",
    "parity:goldens": "node scripts/parity-goldens.mjs --write",
    "flow:onboarding": "node scripts/flow-run.mjs",
    "flow:path": "node scripts/flow-path-run.mjs",
    "flow:station": "node scripts/flow-station-run.mjs",
    "flow:tabs": "node scripts/flow-tabs-run.mjs",
    "flow:largetext": "node scripts/flow-largetext-run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}

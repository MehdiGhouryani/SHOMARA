EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
# Note: In production, MATH_RUNTIME_BACKEND=POSTGRES requires migrations 0031-0034 are applied
MATH_ADULT_BACKEND=
MATH_ADULT_PROJECTION_REPO=
MATH_ASSIGNMENT_BACKEND=
MATH_ASSIGNMENT_REPO=
MATH_CONTENT_BACKEND=
MATH_RUNTIME_BACKEND=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production (>= 32 random chars). Teacher login fails closed without it; the service-role key is NOT used as a fallback.
TEACHER_SESSION_SECRET=
# Mobile release
MOBILE_RELEASE_CHANNEL=preview
# Production Android builds must supply an HTTPS API base (set EXPO_PUBLIC_API_BASE_URL above).
# OTP provider base URL (required in production for parent/child OTP login).
AUTH_OTP_PROVIDER_URL=
# LOCAL DEV ONLY. With no provider configured, /auth/otp/* answers with a fixed mock code (123456)
# so local onboarding does not dead-end. Requires NODE_ENV != production. Never set in production.
# ALLOW_DEV_OTP_MOCK=1
# LOCAL DEV / E2E ONLY. Enables x-dev-* header identities when NODE_ENV is not production. Never set in staging/production.
# ALLOW_DEV_PRINCIPAL=1
# LOCAL DEV ONLY. Enables the built-in teacher seed accounts (teacher_zahra / teacher-dev-01 with TeacherPass123!)
# for `next dev` without Supabase. Requires NODE_ENV != production. Never set in staging/production (fail closed).
# ALLOW_DEV_TEACHER_SEEDS=1
# STAGING DEMO ONLY. Acknowledges that teacher/parent/assignment data lives in process memory and is lost on restart.
# ALLOW_EPHEMERAL_ADULT_STORE=1
